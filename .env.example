# =========================
# APP
# =========================
PORT=3000
APP_URL=https://your-domain.com
DATABASE_PATH=./data/database.sqlite

# =========================
# SECURITY / AUTH
# =========================
# Минимум 32 символа! Сгенерируйте: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=180d
# Только для локальной разработки при коротком JWT_SECRET
ALLOW_INSECURE_DEV_AUTH=false

# Админ-аккаунт (вход в /admin/login по паролю)
ADMIN_EMAIL=admin@el-duck.com
ADMIN_PASSWORD=

# Cookie
AUTH_COOKIE_NAME=ed_user_session
ADMIN_AUTH_COOKIE_NAME=ed_admin_session
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_PATH=/
AUTH_COOKIE_MAX_AGE=180d

# CORS (через запятую)
CORS_ORIGIN=

# Доверять ли X-Forwarded-* заголовкам (для reverse-proxy)
# false | true | <число хопов> | loopback, linklocal, uniquelocal
TRUST_PROXY=true

# =========================
# EMAIL
# =========================
# smtp | sendmail | auto
EMAIL_TRANSPORT=smtp
SENDMAIL_PATH=/usr/sbin/sendmail

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=System Reminder <noreply@el-duck.com>

# =========================
# VPN / PASARGUARD
# =========================
PASARGUARD_BASE_URL=https://your-pasarguard-host:8000
PASARGUARD_ADMIN_USERNAME=
PASARGUARD_ADMIN_PASSWORD=

# =========================
# PAYMENTS
# =========================
# stub (тест), severpay, yookassa
PAYMENT_PROVIDER=stub
PAYMENT_TOPUP_ENABLED=true

# SeverPay
PAYMENT_MID=
PAYMENT_TOKEN=
PAYMENT_CURRENCY=RUB

PAYMENT_API_KEY=
PAYMENT_SECRET=

# =========================
# PUSH / NOTIFY
# =========================
VAPID_KEYS_PATH=./data/vapid-keys.json

NOTIFY_URL=http://localhost:3001
NOTIFY_SECRET=

# =========================
# BILLING
# =========================
EXPIRED_CANCELLED_CHECK_MS=15000
ADMIN_SCENARIO_TESTS_ENABLED=false