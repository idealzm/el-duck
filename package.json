{
  "name": "el-duck-vpn",
  "version": "1.0.0",
  "description": "VPN и Proxy сервис продажи",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "smoke": "bash scripts/smoke-check.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "clean:local": "bash scripts/clean-local.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "payments:reconcile:severpay": "node server/scripts/reconcile-severpay-pending.js"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.5",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
